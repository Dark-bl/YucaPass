
name: YucaPass 5.0 - Android

on:
  push:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: yucapass-android-${{ github.ref }}
  cancel-in-progress: false

jobs:
  android:
    name: Validar y compilar APK
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Obtener proyecto
        uses: actions/checkout@v5

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Configurar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Preparar Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: platform-tools
          accept-android-sdk-licenses: true

      - name: Instalar Android API 36
        run: |
          sdkmanager --install \
            "platforms;android-36" \
            "build-tools;36.0.0" \
            "platform-tools"

      - name: Instalar dependencias
        run: npm install --no-audit --no-fund

      - name: Validar proyecto
        run: npm run check

      - name: Construir versión web
        run: npm run build:web

      - name: Crear proyecto Android
        run: npx cap add android

      - name: Sincronizar Android
        run: npx cap sync android

      - name: Preparar identidad Android
        run: node scripts/prepare-android.mjs

      - name: Generar APK
        run: |
          chmod +x android/gradlew
          cd android
          ./gradlew assembleDebug --no-daemon

      - name: Comprobar APK
        run: test -s android/app/build/outputs/apk/debug/app-debug.apk

      - name: Guardar APK
        uses: actions/upload-artifact@v4
        with:
          name: YucaPass-5.0-APK-debug
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
